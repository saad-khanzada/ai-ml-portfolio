# Public configuration; these values are visible to the browser.
# Find the project ID in Sanity Manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Use the approved public dataset: production.
NEXT_PUBLIC_SANITY_DATASET=

# Use a fixed API date, currently 2026-09-09.
NEXT_PUBLIC_SANITY_API_VERSION=

# Keep private tokens in local/server environment configuration only.
# No private token is required for the current CMS foundation.
